 static uint64_t esp32s3_io_read(void *opaque, hwaddr addr, unsigned int size)
 {
+    /* Headless smoke-test model. Peripherals report deterministic status only. */
+    switch (ESP32S3_IO_START_ADDR + addr) {
+    case 0x6000880c: /* SAR1 conversion complete and fixed ADC sample */
+    case 0x60008830: /* SAR2 conversion complete and fixed ADC sample */
+        return BIT(16) | 2048;
+    case 0x60008850: /* temperature conversion ready and fixed sample */
+        return BIT(8) | 120;
+    case 0x6000e04c: /* analog calibration status */
+        return BIT(24);
+    case 0x6000e050:
+        return 7u << 24;
+    case 0x60006174: /* radio initialization status */
+        return BIT(16);
+    case 0x60033d14:
+        return BIT(0);
+    case 0x6004106c: /* LCD_CAM LCD transfer done interrupt status */
+        return BIT(1);
+    }
     /* The calibration delay is not modelled, so calibration is always done */
     if (ESP32S3_IO_START_ADDR + addr == ESP32S3_I2C_MST_ANA_CONF0_REG) {
         return ESP32S3_I2C_MST_BBPLL_CAL_DONE;
diff --git a/include/hw/misc/esp-smoke-status.h b/include/hw/misc/esp-smoke-status.h
new file mode 100644
index 0000000..a98b75f
--- /dev/null
+++ b/include/hw/misc/esp-smoke-status.h
@@ -0,0 +1,28 @@
+#ifndef HW_MISC_ESP_SMOKE_STATUS_H
+#define HW_MISC_ESP_SMOKE_STATUS_H
+
+#include "exec/memory.h"
+#include "exec/address-spaces.h"
+
+static uint64_t smoke_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return (uintptr_t)opaque;
+}
+
+static void smoke_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+}
+
+static const MemoryRegionOps smoke_status_ops = {
+    .read = smoke_read,
+    .write = smoke_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void smoke_status(const char *name, hwaddr address, uint32_t value)
+{
+    MemoryRegion *mr = g_new0(MemoryRegion, 1);
+    memory_region_init_io(mr, NULL, &smoke_status_ops, (void *)(uintptr_t)value, name, 4);
+    memory_region_add_subregion_overlap(get_system_memory(), address, mr, 2);
+}
+#endif
