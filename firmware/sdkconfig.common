# Shared by bootloader and apps (loaded first; per-project and per-target files override).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions/16mb.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_COLORS=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# Crash evidence for the bootloader `coredump` op.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# TLS to Cloudflare via the IDF certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Full ELF SHA-256 in app descriptors and core dumps, so a crash maps to exactly one released ELF.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64

CONFIG_MBEDTLS_PEM_WRITE_C=y
