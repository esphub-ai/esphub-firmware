menu "EspHub agent (esp-bootloader SDK)"

    config EH_LAUNCHER
        bool "Build the EspHub Launcher"
        default n
        help
            Set only by the EspHub Launcher project. Enables its OTA, provisioning and BLE
            paths in the SDK. Applications leave it off.

    config EH_BL_PROFILE
        string "Compatible EspHub bootloader variant"
        default ""

    config EH_NET_OPENETH
        bool "Use OpenCores Ethernet (QEMU) instead of Wi-Fi"
        depends on ETH_USE_OPENETH
        default n
        help
            For Espressif QEMU builds (-nic user,model=open_eth). Wi-Fi is not initialised.

    config EH_MAX_CMDS
        int "Max registered commands"
        default 24

    config EH_CMD_OUT_MAX
        int "Max command output (bytes)"
        range 256 12288
        default 4096

    config EH_TASK_STACK
        int "Agent task stack size"
        default 6144

    config EH_TASK_PRIO
        int "Agent task priority (keep low)"
        default 2

    config EH_BLE_WIFI
        bool
        default y if EH_LAUNCHER && BT_NIMBLE_ENABLED && !EH_NET_OPENETH

endmenu
