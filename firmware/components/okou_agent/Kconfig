menu "okou agent (esp-bootloader SDK)"

    config OKOU_BOARD_PROFILE
        string "Board profile reported by a board-specific application"
        default ""

    config OKOU_BL_PROFILE
        string "Compatible EspHub bootloader variant"
        default ""

    config OKOU_NET_OPENETH
        bool "Use OpenCores Ethernet (QEMU) instead of Wi-Fi"
        depends on ETH_USE_OPENETH
        default n
        help
            For Espressif QEMU builds (-nic user,model=open_eth). Wi-Fi is not initialised.

    config OKOU_QEMU_SYSTEM_RESET
        bool "QEMU workaround: make esp_restart() a full system reset"
        depends on OKOU_NET_OPENETH
        default y
        help
            Espressif QEMU does not reset peripherals on SW_CPU_RESET; the next boot then
            crashes in esp_timer_init. Only for QEMU builds.

    config OKOU_MAX_CMDS
        int "Max registered commands"
        default 24

    config OKOU_MAX_PARAMS
        int "Max registered params"
        default 24

    config OKOU_CMD_OUT_MAX
        int "Max command output (bytes)"
        range 256 12288
        default 4096

    config OKOU_TASK_STACK
        int "Agent task stack size"
        default 6144

    config OKOU_TASK_PRIO
        int "Agent task priority (keep low)"
        default 2

    config OKOU_MICROPYTHON_RUNTIME
        bool "ESP Hub MicroPython runtime"
        default n

    config OKOU_BLE_WIFI
        bool
        default y if BT_NIMBLE_ENABLED && !OKOU_NET_OPENETH

endmenu
