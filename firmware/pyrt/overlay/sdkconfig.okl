# esp-bootloader Python runtime (appended to the board's sdkconfig fragments).
# Size check against a 4 MiB app partition (the bootloader layout's `app` slot).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_okl_build.csv"
# okou_agent verifies the hub certificate against the IDF bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
# Report the full ELF SHA-256 in firmware diagnostics.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_OKOU_MICROPYTHON_RUNTIME=y

CONFIG_MBEDTLS_PEM_WRITE_C=y
# IDF 5.5's HTTPS client links the ALPN setter even with no protocol override.
CONFIG_MBEDTLS_SSL_ALPN=y

CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
