{
  "name": "reTerminal E1004",
  "model": "Seeed Studio reTerminal E1004",
  "chip": "esp32s3",
  "flash_mb": 32,
  "bootloader": "esp32s3-32mb-uart",
  "psram": "octal",
  "default_example": "blink",
  "examples": [
