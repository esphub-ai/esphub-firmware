{
  "name": "XIAO ESP32-S3",
  "model": "Seeed Studio XIAO ESP32-S3",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "psram": "octal",
  "default_example": "blink",
  "examples": [
    {
      "id": "blink",
      "description": "Blink the onboard user LED on GPIO21 every half second.",
      "entrypoint": "examples/blink/main.c",
      "upstream": "https://github.com/arduino/arduino-examples/blob/50b66a3ce1e4e5e69cd96d3af5ca41a3383b311a/examples/01.Basics/Blink/Blink.ino"
    }
  ]
}
