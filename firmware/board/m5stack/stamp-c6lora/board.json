{
  "name": "Stamp C6LoRa",
  "model": "M5Stack Stamp C6LoRa",
  "chip": "esp32c6",
  "flash_mb": 16,
  "bootloader": "esp32c6-16mb",
  "default_example": "hello-serial",
  "examples": [
    {
      "id": "hello-serial",
      "description": "Print a greeting once per second on the serial console. The SDK connects in parallel using the saved Wi-Fi credentials.",
      "entrypoint": "examples/hello-serial/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5stamp_c6lora/program"
    }
  ]
}
