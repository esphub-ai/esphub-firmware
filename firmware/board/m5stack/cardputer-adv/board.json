{
  "name": "Cardputer-Adv",
  "model": "M5Stack Cardputer-Adv",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "m5_board_id": 24,
  "default_example": "display-shapes",
  "examples": [
    {
      "id": "display-shapes",
      "description": "Draw randomly positioned colored circles and rectangles on the LCD. Change the primitives and colors in the drawing loop.",
      "entrypoint": "examples/display-shapes/main.cpp",
      "upstream": "https://github.com/m5stack/M5Cardputer/blob/bf64d3178ab43928fa02365fbe3937cec99716ad/examples/Basic/display/display.ino"
    },
    {
      "id": "buttons",
      "description": "Show a button test immediately. Press or hold the G0 button to change the on-screen state and count presses.",
      "entrypoint": "examples/buttons/main.cpp",
      "upstream": "https://github.com/m5stack/M5Cardputer/blob/bf64d3178ab43928fa02365fbe3937cec99716ad/examples/Basic/button/button.ino"
    }
  ]
}
