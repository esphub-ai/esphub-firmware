{
  "name": "DinMeter",
  "model": "M5Stack DinMeter",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "m5_board_id": 13,
  "default_example": "hello-display",
  "examples": [
    {
      "id": "hello-display",
      "description": "Draw positioned text on the LCD and print the greeting over serial. Adjust the cursor coordinates to change the layout.",
      "entrypoint": "examples/hello-display/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5dinmeter/program"
    }
  ]
}
