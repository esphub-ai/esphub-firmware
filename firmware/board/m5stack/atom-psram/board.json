{
  "name": "Atom-PSRAM",
  "model": "M5Stack Atom-PSRAM",
  "chip": "esp32",
  "flash_mb": 8,
  "bootloader": "esp32-8mb",
  "m5_board_id": 129,
  "default_example": "buttons",
  "examples": [
    {
      "id": "buttons",
      "description": "Read button transitions and click counts. The serial log identifies the button and gesture; screens also show a colored indicator.",
      "entrypoint": "examples/buttons/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Basic/Button/Button.ino"
    },
    {
      "id": "i2c-tester",
      "description": "Scan the Atom-PSRAM Grove I2C bus and print responding addresses over serial.",
      "entrypoint": "examples/i2c-tester/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/I2C_Tester/I2C_Tester.ino"
    },
    {
      "id": "counter",
      "description": "Increment a persistent boot counter and restart the Atom-PSRAM after ten seconds.",
      "entrypoint": "examples/counter/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/Storage/Counter/Counter.ino"
    },
    {
      "id": "storage-notes",
      "description": "Create a LittleFS note on the Atom-PSRAM and read it over serial with the board button.",
      "entrypoint": "examples/storage-notes/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/Storage/SPIFFS/SPIFFS/SPIFFS.ino"
    },
    {
      "id": "storage-append",
      "description": "Create an empty LittleFS note or append one line to the existing note at startup.",
      "entrypoint": "examples/storage-append/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/Storage/SPIFFS/SPIFFS_Add/SPIFFS_Add.ino"
    }
  ]
}
