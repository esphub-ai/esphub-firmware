{
  "name": "Atom-PSRAM",
  "model": "M5Stack Atom-PSRAM",
  "chip": "esp32",
  "flash_mb": 8,
  "bootloader": "esp32-8mb",
  "m5_board_id": 129,
  "default_example": "buttons",
  "examples": [
    {
      "id": "buttons",
      "description": "Read button transitions and click counts. The serial log identifies the button and gesture; screens also show a colored indicator.",
      "entrypoint": "examples/buttons/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Basic/Button/Button.ino"
    },
    {
      "id": "i2c-tester",
      "description": "Scan the Atom-PSRAM Grove I2C bus and print responding addresses over serial.",
      "entrypoint": "examples/i2c-tester/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/I2C_Tester/I2C_Tester.ino"
    },
    {
      "id": "counter",
      "description": "Increment a persistent boot counter and restart the Atom-PSRAM after ten seconds.",
      "entrypoint": "examples/counter/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/Storage/Counter/Counter.ino"
    },
    {
      "id": "storage-notes",
      "description": "Create a LittleFS note on the Atom-PSRAM and read it over serial with the board button.",
      "entrypoint": "examples/storage-notes/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/Storage/SPIFFS/SPIFFS/SPIFFS.ino"
    },
    {
      "id": "storage-append",
      "description": "Create an empty LittleFS note or append one line to the existing note at startup.",
      "entrypoint": "examples/storage-append/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/Storage/SPIFFS/SPIFFS_Add/SPIFFS_Add.ino"
    },
    {
      "id": "storage-delete",
      "description": "Delete the regular LittleFS sample note on Atom-PSRAM and report the result over serial.",
      "entrypoint": "examples/storage-delete/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/Storage/SPIFFS/SPIFFS_Delete/SPIFFS_Delete.ino"
    },
    {
      "id": "eeprom",
      "description": "Write and read a persistent 32-byte EEPROM sample using the Atom-PSRAM button.",
      "entrypoint": "examples/eeprom/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/Storage/EEPROM/EEPROM.ino"
    },
    {
      "id": "multitask",
      "description": "Run three pinned FreeRTOS tasks at different priorities and periods while the Atom-PSRAM RGB pixel is orange.",
      "entrypoint": "examples/multitask/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/MultiTask/MultiTask.ino"
    },
    {
      "id": "led-set",
      "description": "Cycle the Atom-PSRAM RGB pixel through four colors with the board button.",
      "entrypoint": "examples/led-set/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Basics/LEDSet/LEDSet.ino"
    },
    {
      "id": "mult-serial",
      "description": "Forward raw bytes bidirectionally between UART0 and the Grove UART on Atom-PSRAM.",
      "entrypoint": "examples/mult-serial/main.cpp",
      "upstream": "https://github.com/m5stack/M5Atom/blob/4717fcfff7edd8d638b51fcbd7c3a869c2423990/examples/Advanced/MultSerial/MultSerial.ino"
    }
  ]
}
