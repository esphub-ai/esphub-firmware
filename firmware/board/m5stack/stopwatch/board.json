{
  "name": "StopWatch",
  "model": "M5Stack Stopwatch",
  "chip": "esp32s3",
  "flash_mb": 16,
  "bootloader": "esp32s3-16mb",
  "m5_board_id": 30,
  "default_example": "bar-graph",
  "examples": [
    {
      "id": "bar-graph",
      "description": "Animate colored bars and peak markers on the onboard display. Change the palette or feed sensor readings into the plotted heights.",
      "entrypoint": "examples/bar-graph/main.cpp",
      "upstream": "https://github.com/m5stack/M5GFX/blob/28d47949bdc84f30881623476f555398e2194313/examples/Basic/BarGraph/BarGraph.ino"
    },
    {
      "id": "buttons",
      "description": "Read button transitions and click counts. The serial log identifies the button and gesture; screens also show a colored indicator.",
      "entrypoint": "examples/buttons/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Basic/Button/Button.ino"
    }
  ]
}
