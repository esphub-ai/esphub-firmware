{
  "name": "Chain DualKey",
  "model": "M5Stack Chain DualKey",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "m5_board_id": 147,
  "default_example": "key-press",
  "examples": [
    {
      "id": "key-press",
      "description": "Read Key 1 and report press and release transitions over serial. Use it as the start of a hardware shortcut.",
      "entrypoint": "examples/key-press/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/chain_dualkey/program"
    }
  ]
}
