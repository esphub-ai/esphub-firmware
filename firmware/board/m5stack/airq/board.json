{
  "name": "Air Quality",
  "model": "M5Stack Air Quality",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "m5_board_id": 15,
  "default_example": "hello-display",
  "examples": [
    {
      "id": "buzzer",
      "description": "Display the song title and play Twinkle Twinkle Little Star on the GPIO9 buzzer.",
      "entrypoint": "examples/buzzer/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/buzzer"
    },
    {
      "id": "battery",
      "description": "Measure the AirQ battery on GPIO14 and refresh its voltage on the e-paper display.",
      "entrypoint": "examples/battery/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/battery"
    },
    {
      "id": "button",
      "description": "Report clicks on AirQ buttons A and B to the e-paper display and serial console.",
      "entrypoint": "examples/button/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/button"
    },
    {
      "id": "hello-display",
      "description": "Show Hello World on the e-paper display and serial console. Edit the text and font size.",
      "entrypoint": "examples/hello-display/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/program"
    }
  ]
}
