{
  "name": "Air Quality",
  "model": "M5Stack Air Quality",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "m5_board_id": 15,
  "default_example": "hello-display",
  "examples": [
    {
      "id": "wakeup",
      "description": "Enter deep sleep with button A and display the timer wakeup after five seconds.",
      "entrypoint": "examples/wakeup/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/wakeup"
    },
    {
      "id": "sen55",
      "description": "Display particulate matter, humidity, temperature, VOC and NOx from the AirQ SEN55.",
      "entrypoint": "examples/sen55/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/sen55"
    },
    {
      "id": "scd40",
      "description": "Show CO₂, temperature and humidity from the AirQ onboard SCD40 sensor.",
      "entrypoint": "examples/scd40/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/scd40"
    },
    {
      "id": "display",
      "description": "Continuously draw random circles and rectangles on the AirQ e-paper screen.",
      "entrypoint": "examples/display/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/display"
    },
    {
      "id": "buzzer",
      "description": "Display the song title and play Twinkle Twinkle Little Star on the GPIO9 buzzer.",
      "entrypoint": "examples/buzzer/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/buzzer"
    },
    {
      "id": "battery",
      "description": "Measure the AirQ battery on GPIO14 and refresh its voltage on the e-paper display.",
      "entrypoint": "examples/battery/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/battery"
    },
    {
      "id": "button",
      "description": "Report clicks on AirQ buttons A and B to the e-paper display and serial console.",
      "entrypoint": "examples/button/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/button"
    },
    {
      "id": "hello-display",
      "description": "Show Hello World on the e-paper display and serial console. Edit the text and font size.",
      "entrypoint": "examples/hello-display/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/m5air_quality/program"
    }
  ]
}
