{
  "name": "Paper Color",
  "model": "M5Stack Paper Color",
  "chip": "esp32s3",
  "flash_mb": 16,
  "bootloader": "esp32s3-16mb",
  "m5_board_id": 28,
  "default_example": "color-bands",
  "shared_example_inputs": {
    "sht4x.hpp": ["sht40", "uiflow-sht4x"]
  },
  "examples": [
    {
      "id": "basic-display",
      "description": "Show a red frame, colored lettering, panel information and a six-color swatch on the Paper Color display.",
      "entrypoint": "examples/basic-display/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/display"
    },
    {
      "id": "battery-status",
      "description": "Show battery and USB input readings and indicate external power with the two onboard LEDs.",
      "entrypoint": "examples/battery-status/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/battery"
    },
    {
      "id": "button",
      "description": "Show a startup prompt and report presses of the three Paper Color buttons over serial.",
      "entrypoint": "examples/button/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/button"
    },
    {
      "id": "easy-tag",
      "description": "Choose one of three microSD PNG name tags with A, B or C, then retain the image in deep sleep.",
      "entrypoint": "examples/easy-tag/main.cpp",
      "upstream": "https://github.com/nananauno/M5PEasyTag/tree/bcef44354ad910c78c55e15124aa4fd0853947fd"
    },
    {
      "id": "ir-nec",
      "description": "Send NEC infrared frames on the onboard transmitter and show the current address and command.",
      "entrypoint": "examples/ir-nec/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/ir_nec"
    },
    {
      "id": "microsd-png",
      "description": "Display two PNG files from the microSD card, switching images once a minute.",
      "entrypoint": "examples/microsd-png/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/microsd"
    },
    {
      "id": "rgb-led",
      "description": "Cycle the two onboard RGB LEDs through single-pixel, mixed and matched colors.",
      "entrypoint": "examples/rgb-led/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/rgb_led"
    },
    {
      "id": "rtc-local",
      "description": "Set the onboard RTC to a sample local date and time, then refresh the displayed clock each minute.",
      "entrypoint": "examples/rtc-local/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/rtc"
    },
    {
      "id": "m5pm1-wakeup",
      "description": "Use M5PM1 timers to schedule power-on with Button A or power-off with Button B.",
      "entrypoint": "examples/m5pm1-wakeup/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/wakeup#m5pm1-timer-wakeup"
    },
    {
      "id": "mic-record",
      "description": "Hold Button A to record audio, then release it to play the recording on the onboard speaker.",
      "entrypoint": "examples/mic-record/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/mic"
    },
    {
      "id": "rtc-pm1-wake",
      "description": "Use the RX8130 timer and PMIC GPIO2 to power on after a five-second RTC interval.",
      "entrypoint": "examples/rtc-pm1-wake/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/m5pm1"
    },
    {
      "id": "rtc-wakeup",
      "description": "Press Button A to sleep and restart after five seconds using the onboard RTC.",
      "entrypoint": "examples/rtc-wakeup/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/wakeup#rtc-wakeup-for-esp32-s3"
    },
    {
      "id": "speaker-tone",
      "description": "Play alternating 4 kHz and 8 kHz tones on the onboard speaker.",
      "entrypoint": "examples/speaker-tone/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/speaker"
    },
    {
      "id": "uiflow-sht4x",
      "description": "Print humidity and temperature from the onboard SHT4X sensor every second, following the UiFlow2 example.",
      "entrypoint": "examples/uiflow-sht4x/main.cpp",
      "upstream": "https://github.com/m5stack/uiflow-micropython/blob/a61a29409f09f1f4bebae05e15c4bd6dcc4956b6/examples/hardware/sht4x/sht4x_papercolor_example.py"
    },
    {
      "id": "sht40",
      "description": "Read the onboard SHT40 and show temperature and humidity at startup and every two minutes.",
      "entrypoint": "examples/sht40/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/sht40"
    },
    {
      "id": "color-bands",
      "description": "Draw six colored bands and a multicolored label on the e-paper display using an offscreen canvas.",
      "entrypoint": "examples/color-bands/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/papercolor/program"
    },
    {
      "id": "factory-demo",
      "description": "M5Stack PaperColor factory photo frame with a local gallery and EzData.",
      "entrypoint": "examples/factory-demo/main.cpp",
      "upstream": "https://github.com/m5stack/M5PaperColor-UserDemo/tree/884a7b7ebe1d5f1ca55c0dc4864f7708636677ea"
    },
    {
      "id": "sd-image-viewer",
      "description": "Browse JPEG, PNG and BMP images on microSD with A/B or a configurable slideshow.",
      "entrypoint": "examples/sd-image-viewer/main.cpp",
      "upstream": "https://github.com/3110/m5stack-image-viewer/tree/d5867307e58664dd492bac6ae6ac7b40e5d0c798"
    }
  ],
  "psram": "octal"
}
