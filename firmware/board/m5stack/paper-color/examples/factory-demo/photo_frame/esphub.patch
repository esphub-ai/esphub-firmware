+// Both factory routes switch the same radio. Preserve the previous owner on
+// failure, including when the HTTP client stays reachable over another uplink.
+static esp_err_t apply_network_request(httpd_req_t *req, const char *mode, const char *ssid,
+                                       const char *password, const char *device_name, bool &acknowledged)
+{
+    acknowledged = false;
+    const bool select_mode = mode && *mode;
+    if (!select_mode && !ssid) return ESP_OK;
+    const bool hotspot = paper_hotspot_ipv4() != 0;
+    const bool local = select_mode && !strcmp(mode, MODE_ID_LOCAL);
+    if (hotspot && ssid && !select_mode && strcmp(g_dev_state.current_mode, MODE_ID_EZDATA)) {
+        app_server_set_connect_failed_state("select Internet mode to leave the hotspot");
+        return ESP_ERR_INVALID_ARG;
+    }
+    if (!local && !ssid && !eh_wifi_count()) {
+        app_server_set_connect_failed_state("configure Wi-Fi first");
+        return ESP_ERR_INVALID_ARG;
+    }
+
+    const bool changing_owner = local != hotspot;
+    if (changing_owner && paper_network::socket_on_wifi(httpd_req_to_sockfd(req), hotspot)) {
+        acknowledged = true; // a partial response must never be sent a second time
+        if (acknowledge_handoff(req, local, device_name) != ESP_OK) return ESP_FAIL;
+    }
+    if (select_mode) app_server_set_requested_mode(mode);
+    esp_err_t err = ESP_OK;
+    if (ssid && !local) {
+        app_server_set_connecting_state(mode);
+        if (perform_wifi_connect(ssid, password) != 0) err = ESP_FAIL;
+    }
+    if (err == ESP_OK && select_mode) {
+        err = app_manager_apply_mode(mode);
+        if (err != ESP_OK) app_server_set_connect_failed_state("mode switch failed");
+    }
+    if (err != ESP_OK && changing_owner) {
+        esp_err_t restored = hotspot ? app_manager_disconnect_sta_keep_ap() : paper_network::use_station();
+        if (restored != ESP_OK) app_server_set_connect_failed_state("network recovery failed");
+    }
+    return err;
+}
+
+static esp_err_t network_error(httpd_req_t *req, esp_err_t err, bool acknowledged)
+{
+    if (acknowledged) return ESP_OK;
+    return send_error_response(req, err == ESP_ERR_INVALID_ARG ? 400 : 500, g_dev_state.conn_err);
+}
