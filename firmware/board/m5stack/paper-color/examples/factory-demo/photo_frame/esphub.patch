+/* EspHub's shared data partition is also used by other apps. Initialize a blank
+ * volume only and expose just this application's gallery through the factory API. */
+static const esp_partition_t *shared_gallery_partition()
+{
+    if (esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_FAT, NULL)) {
+        return nullptr;
+    }
+    return esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_LITTLEFS, "data");
+}
+
+static bool partition_erased(const esp_partition_t *part)
+{
+    std::array<uint8_t, 1024> bytes;
+    for (size_t pos = 0; pos < part->size; pos += bytes.size()) {
+        const size_t n = std::min<size_t>(bytes.size(), part->size - pos);
+        if (esp_partition_read(part, pos, bytes.data(), n) != ESP_OK ||
+            !std::all_of(bytes.begin(), bytes.begin() + n, [](uint8_t byte) { return byte == 0xff; })) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static esp_err_t mount_shared_gallery(const esp_partition_t *part)
+{
+    if (!esp_littlefs_mounted("data")) {
+        esp_vfs_littlefs_conf_t conf = {};
+        conf.base_path = "/paperfs";
+        conf.partition_label = "data";
+        esp_err_t err = esp_vfs_littlefs_register(&conf);
+        if (err == ESP_FAIL && partition_erased(part)) {
+            conf.format_if_mount_failed = true;
+            err = esp_vfs_littlefs_register(&conf);
+        }
+        if (err != ESP_OK) return err;
+    }
+    if (mkdir(GALLERY_DIR, 0775) != 0 && errno != EEXIST) return ESP_FAIL;
+    struct stat entry = {};
+    if (stat(GALLERY_DIR, &entry) != 0 || !S_ISDIR(entry.st_mode)) return ESP_FAIL;
+    s_gallery_active = true;
+    s_ctx.media = APP_STORAGE_MEDIA_SPIFLASH;
+    ESP_LOGI(TAG, "Internal gallery ready at %s", GALLERY_DIR);
+    return ESP_OK;
+}
+
+const char *hal_storage_photo_dir(void)
+{
+    return s_gallery_active ? GALLERY_DIR : BASE_PATH;
+}
+
+esp_err_t hal_storage_space(uint64_t *total, uint64_t *free_bytes)
+{
+    hal_storage_lock();
+    esp_err_t err;
+    if (s_gallery_active) {
+        size_t volume = 0, used = 0;
+        err = esp_littlefs_info("data", &volume, &used);
+        if (err == ESP_OK) {
+            *total = volume;
+            *free_bytes = volume - used;
+        }
+    } else {
+        err = esp_vfs_fat_info(BASE_PATH, total, free_bytes);
+    }
+    hal_storage_unlock();
+    return err;
+}
