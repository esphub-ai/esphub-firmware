{
  "name": "Atom VoiceS3R",
  "model": "M5Stack Atom VoiceS3R",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "m5_board_id": 145,
  "default_example": "tones",
  "examples": [
    {
      "id": "sd-wav",
      "description": "Play PCM WAV files from the root of an Atomic TFCard Base (A135), with status on the serial console.",
      "entrypoint": "examples/sd-wav/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Advanced/Speaker_SD_wav_file/Speaker_SD_wav_file.ino"
    },
    {
      "id": "mic-fft",
      "description": "Analyze microphone audio and report its peak frequency and spectrum on the serial console.",
      "entrypoint": "examples/mic-fft/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Advanced/Mic_FFT/Mic_FFT.ino"
    },
    {
      "id": "speaker",
      "description": "Use button A to control looping audio and master or channel volume.",
      "entrypoint": "examples/speaker/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Basic/Speaker/Speaker.ino"
    },
    {
      "id": "microphone",
      "description": "Record continuously and click button A to play recent microphone audio.",
      "entrypoint": "examples/microphone/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Basic/Microphone/Microphone.ino"
    },
    {
      "id": "tones",
      "description": "Play alternating high and low tones on the speaker. Change their frequencies and durations.",
      "entrypoint": "examples/tones/main.cpp",
      "upstream": "https://docs.m5stack.com/en/arduino/atom_echos3r/program"
    }
  ]
}
