{
  "name": "CoreS3",
  "model": "M5Stack CoreS3",
  "chip": "esp32s3",
  "flash_mb": 16,
  "bootloader": "esp32s3-16mb",
  "m5_board_id": 10,
  "default_example": "bar-graph",
  "examples": [
    {
      "id": "bar-graph",
      "description": "Animate colored bars and peak markers on the onboard display. Change the palette or feed sensor readings into the plotted heights.",
      "entrypoint": "examples/bar-graph/main.cpp",
      "upstream": "https://github.com/m5stack/M5GFX/blob/28d47949bdc84f30881623476f555398e2194313/examples/Basic/BarGraph/BarGraph.ino"
    },
    {
      "id": "touch-drag",
      "description": "Drag colored boxes on the touchscreen. Edit the touch handlers and drawing code to build an interactive interface.",
      "entrypoint": "examples/touch-drag/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Basic/Touch/DragDrop/DragDrop.ino"
    }
  ],
  "psram": "octal"
}
