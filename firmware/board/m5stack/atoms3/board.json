{
  "name": "AtomS3",
  "model": "M5Stack AtomS3",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "m5_board_id": 11,
  "default_example": "display-shapes",
  "shared_example_inputs": {
    "storage_io.hpp": ["storage-notes", "storage-append", "storage-delete"],
    "atomic_poe.hpp": ["atomic-poe-http", "atomic-poe-mqtt", "atomic-poe-webserver"],
    "sim7020.hpp": ["uiflow-nbiot-http", "uiflow-nbiot-mqtt", "uiflow-nbiot2-http", "uiflow-nbiot2-mqtt", "uiflow-nbiot2v11-http", "uiflow-nbiot2v11-mqtt"],
    "sim7028.hpp": ["uiflow-nbiot2-http", "uiflow-nbiot2-mqtt", "uiflow-nbiot2v11-http", "uiflow-nbiot2v11-mqtt"],
    "nbiot_mqtt.hpp": ["uiflow-nbiot-mqtt", "uiflow-nbiot2-mqtt", "uiflow-nbiot2v11-mqtt"],
    "nbiot2v11_startup.hpp": ["uiflow-nbiot2v11-http", "uiflow-nbiot2v11-mqtt"],
    "sim7028_http.hpp": ["uiflow-nbiot2-http", "uiflow-nbiot2v11-http"],
    "qrcode_base.hpp": ["uiflow-qrcode-auto", "uiflow-qrcode-host", "uiflow-qrcode-key", "uiflow-qrcode-motion", "uiflow-qrcode-pulse", "uiflow-qrcode2-auto", "uiflow-qrcode2-continuous", "uiflow-qrcode2-key", "uiflow-qrcode2-motion", "uiflow-qrcode2-pulse"],
    "qrcode2_base.hpp": ["uiflow-qrcode2-auto", "uiflow-qrcode2-continuous", "uiflow-qrcode2-key", "uiflow-qrcode2-motion", "uiflow-qrcode2-pulse"]
  },
  "examples": [
