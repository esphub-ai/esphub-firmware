{
  "name": "AtomS3",
  "model": "M5Stack AtomS3",
  "chip": "esp32s3",
  "flash_mb": 8,
  "bootloader": "esp32s3-8mb",
  "m5_board_id": 11,
  "default_example": "display-shapes",
  "shared_example_inputs": {
    "storage_io.hpp": ["storage-notes", "storage-append", "storage-delete"],
    "atomic_poe.hpp": ["atomic-poe-http", "atomic-poe-mqtt", "atomic-poe-webserver"]
  },
  "examples": [
    {
      "id": "display-shapes",
      "description": "Draw randomly positioned colored circles and rectangles on the LCD. Change the primitives and colors in the drawing loop.",
      "entrypoint": "examples/display-shapes/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Basics/display/display.ino"
    },
    {
      "id": "buttons",
      "description": "Read button transitions and click counts. The serial log identifies the button and gesture; screens also show a colored indicator.",
      "entrypoint": "examples/buttons/main.cpp",
      "upstream": "https://github.com/m5stack/M5Unified/blob/96576a14247ddc935149145aa6b51943464120f1/examples/Basic/Button/Button.ino"
    },
    {
      "id": "ir-nec",
      "description": "Send extended NEC frames on GPIO4 and show the incrementing command on the LCD.",
      "entrypoint": "examples/ir-nec/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Basics/ir_nec/ir_nec.ino"
    },
    {
      "id": "imu",
      "description": "Read the built-in MPU6886 accelerometer and gyroscope and refresh their values on the LCD.",
      "entrypoint": "examples/imu/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Basics/imu/imu.ino"
    },
    {
      "id": "i2c-tester",
      "description": "Continuously scan the external I2C bus and show responding addresses on the LCD.",
      "entrypoint": "examples/i2c-tester/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Advanced/I2C_Tester/I2C_Tester.ino"
    },
    {
      "id": "counter",
      "description": "Increment a persistent NVS counter on each boot and restart after 10 seconds.",
      "entrypoint": "examples/counter/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Advanced/Storage/Counter/Counter.ino"
    },
    {
      "id": "storage-notes",
      "description": "Write a sample text file to the existing LittleFS data volume and press A to read it back.",
      "entrypoint": "examples/storage-notes/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Advanced/Storage/SPIFFS/SPIFFS/SPIFFS.ino"
    },
    {
      "id": "storage-append",
      "description": "Append a line to the LittleFS notes file or create an empty note, then press A to read it.",
      "entrypoint": "examples/storage-append/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Advanced/Storage/SPIFFS/SPIFFS_Add/SPIFFS_Add.ino"
    },
    {
      "id": "storage-delete",
      "description": "Remove the example's own LittleFS notes file and show the result.",
      "entrypoint": "examples/storage-delete/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Advanced/Storage/SPIFFS/SPIFFS_Delete/SPIFFS_Delete.ino"
    },
    {
      "id": "eeprom",
      "description": "Press A to write and read back 16 persistent EEPROM-style bytes.",
      "entrypoint": "examples/eeprom/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Advanced/Storage/EEPROM/EEPROM.ino"
    },
    {
      "id": "multitask",
      "description": "Run three FreeRTOS tasks pinned to core 0 that log uptime every 100, 200, and 1000 ms while showing a serial-port notice on the LCD.",
      "entrypoint": "examples/multitask/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Advanced/MultiTask/MultiTask.ino"
    },
    {
      "id": "atomic-pwm",
      "description": "Drive a 10 kHz 10-bit LEDC PWM ramp on GPIO5 for the Atomic PWM Base while displaying PWM in green on the LCD.",
      "entrypoint": "examples/atomic-pwm/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicPWM/AtomicPWM.ino"
    },
    {
      "id": "atomic-hdriver",
      "description": "Control the Atomic H-Driver Base with BtnA, display H-Driver on the LCD, and report input voltage and faults over serial.",
      "entrypoint": "examples/atomic-hdriver/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicHDriver/AtomicHDriver.ino"
    },
    {
      "id": "atomic-motion",
      "description": "Run the Atomic Motion Base demo for two DC motors and four servos over I2C, with command readback on the serial console.",
      "entrypoint": "examples/atomic-motion/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicMotion/AtomicMotion.ino"
    },
    {
      "id": "atomic-gps",
      "description": "Read Atomic GPS Base NMEA over UART and report position, time, movement and receiver diagnostics on the serial console.",
      "entrypoint": "examples/atomic-gps/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicGPS/GPS/GPS.ino"
    },
    {
      "id": "atomic-gps-microsd",
      "description": "Mount the Atomic GPS Base microSD card, show its space usage and exercise FAT directory and file operations in an isolated test directory.",
      "entrypoint": "examples/atomic-gps-microsd/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicGPS/MicroSD/MicroSD.ino"
    },
    {
      "id": "atomic-poe-link",
      "description": "Read the Atomic PoE Base W5500 Ethernet link and show Unknown, ON or OFF on the LCD and serial console.",
      "entrypoint": "examples/atomic-poe-link/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicPoE/LinkStatus/LinkStatus.ino"
    },
    {
      "id": "atomic-poe-http",
      "description": "Use Atomic PoE Base Ethernet and DHCP to make HTTP GET and POST requests. Read the responses on the LCD and serial console.",
      "entrypoint": "examples/atomic-poe-http/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicPoE/HTTP/HTTP.ino"
    },
    {
      "id": "atomic-poe-mqtt",
      "description": "Publish and subscribe over wired Ethernet using an Atomic PoE Base. Show MQTT activity on the LCD and serial console.",
      "entrypoint": "examples/atomic-poe-mqtt/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicPoE/MQTT/MQTT.ino"
    },
    {
      "id": "atomic-poe-webserver",
      "description": "Serve the official Atomic PoE Base welcome page over wired Ethernet and show the DHCP address on the LCD.",
      "entrypoint": "examples/atomic-poe-webserver/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicPoE/WebServer/WebServer.ino"
    },
    {
      "id": "atomic-spk-mp3",
      "description": "Play /11-fanfare.mp3 from the Atomic SPK Base microSD card over I2S and report playback status.",
      "entrypoint": "examples/atomic-spk-mp3/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicSPK/PlayMP3FromSD/PlayMP3FromSD.ino"
    },
    {
      "id": "atomic-spk-raw-pcm",
      "description": "Play a raw PCM click through the Atomic SPK Base when BtnA is clicked.",
      "entrypoint": "examples/atomic-spk-raw-pcm/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/AtomicBase/AtomicSPK/PlayRawPCM/PlayRawPCM.ino"
    },
    {
      "id": "mini-can-master",
      "description": "Alternate the Mini CAN Unit on and off commands on the 25 kbit/s CAN bus.",
      "entrypoint": "examples/mini-can-master/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Unit/MiniCAN_TJA1051T/Master/Master.ino"
    },
    {
      "id": "mini-can-slave",
      "description": "Receive and print Mini CAN Unit frames on a 25 kbit/s CAN bus.",
      "entrypoint": "examples/mini-can-slave/main.cpp",
      "upstream": "https://github.com/m5stack/M5AtomS3/blob/8accfe68d45ac8b31580e3067a0ecedfbf2d49c7/examples/Unit/MiniCAN_TJA1051T/Slave/Slave.ino"
    },
    {
      "id": "uiflow-can-base",
      "description": "Send and receive frames with the AtomS3 Atomic CAN Base at 1 Mbit/s.",
      "entrypoint": "examples/uiflow-can-base/main.cpp",
      "upstream": "https://github.com/m5stack/uiflow-micropython/blob/a61a29409f09f1f4bebae05e15c4bd6dcc4956b6/examples/base/can/atoms3_can_example.py"
    },
    {
      "id": "uiflow-nbiot-http",
      "description": "Send the UiFlow2 HTTP POST through the Atom DTU SIM7020 NB-IoT modem.",
      "entrypoint": "examples/uiflow-nbiot-http/main.cpp",
      "upstream": "https://github.com/m5stack/uiflow-micropython/blob/a61a29409f09f1f4bebae05e15c4bd6dcc4956b6/examples/base/dtu_nbiot/atoms3_base_nbiot_http_example.py"
    }
  ]
}
