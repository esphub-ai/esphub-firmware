      "upstream": "https://github.com/waveshareteam/ESP32-S3-Touch-AMOLED-1.75C/blob/9b295b183746e96dad519f47575b787a014b3fec/examples/arduino/examples/01_HelloWorld/01_HelloWorld.ino"
    }
  ]
}
