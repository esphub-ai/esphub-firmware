{
  "name": "ESP32-S3-Touch-LCD-3.49",
  "model": "Waveshare ESP32-S3-Touch-LCD-3.49",
  "chip": "esp32s3",
  "flash_mb": 16,
  "bootloader": "esp32s3-16mb",
  "psram": "octal",
  "default_example": "rtc-clock",
  "examples": [
    {
      "id": "rtc-clock",
      "description": "Read the onboard PCF85063 clock on SDA GPIO47 and SCL GPIO48. Log its hours, minutes and seconds without setting the clock.",
      "entrypoint": "examples/rtc-clock/main.c",
      "upstream": "https://github.com/waveshareteam/ESP32-S3-Touch-LCD-3.49/blob/def6edd0b6e1925ed09702eed01a2f181afdf8c1/Examples/Arduino/02_I2C_PCF85063/02_I2C_PCF85063.ino"
    },
    {
      "id": "backlight-v1",
      "description": "V1 PCB: blink the display backlight on GPIO8.",
      "entrypoint": "examples/backlight-v1/main.c",
      "upstream": "https://github.com/waveshareteam/ESP32-S3-Touch-LCD-3.49/blob/def6edd0b6e1925ed09702eed01a2f181afdf8c1/Examples/Arduino/09_LVGL_V8_Test/09_LVGL_V8_Test.ino"
    },
    {
      "id": "backlight-v2",
      "description": "V2 PCB: blink the display backlight on GPIO42.",
      "entrypoint": "examples/backlight-v2/main.c",
      "upstream": "https://github.com/waveshareteam/ESP32-S3-Touch-LCD-3.49-V2/blob/1c157e6e8e68b89fd4dc400f46bf1724cb64a57e/Arduino/examples/09_LVGL_V8_Test/09_LVGL_V8_Test.ino"
    }
  ]
}
