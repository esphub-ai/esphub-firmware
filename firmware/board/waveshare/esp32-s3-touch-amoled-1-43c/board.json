      "upstream": "https://github.com/waveshareteam/ESP32-S3-Touch-AMOLED-1.43C/blob/8cea11ddae6167dd591d1f5465fd7b615080360f/examples/arduino/examples/05_LVGL_Widgets/05_LVGL_Widgets.ino"
    }
  ]
}
